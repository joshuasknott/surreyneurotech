# Existing shared Convex service used by the public website.
CONVEX_URL=https://your-project.convex.cloud
CONVEX_SITE_URL=https://your-project.convex.site
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev

# Public assistant (server-side only; never use a PUBLIC_ prefix).
GEMINI_API_KEY=
AI_FEATURES_ENABLED=true
AI_MODEL=gemini-3.1-flash-lite
AI_FALLBACK_MODEL=gemini-3.1-flash-lite
AI_THINKING_LEVEL=minimal
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_MS=15000
AI_ASSISTANT_MAX_INPUT_CHARS=1200
AI_ASSISTANT_MAX_MESSAGES=12
ASSISTANT_RATE_LIMIT_SECRET=replace-with-a-long-random-string

# Optional server-side contact/application delivery. The public contact form
# normally opens the visitor's email app.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
COMMITTEE_FROM_EMAIL=
BLOB_READ_WRITE_TOKEN=
APPLICATIONS_CLOSE_AT=

# Only required by the applications service when its upload/email route is used.
# Keep all real values in the relevant Vercel project settings.
