{
  "name": "surreyneurotech",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/neurotech",
    "apps/neurotech-applications",
    "packages/*"
  ],
  "scripts": {
    "dev:neurotech": "npm run dev -w apps/neurotech",
    "dev:neurotech-applications": "npm run dev -w apps/neurotech-applications -- --port 4324",
    "build:neurotech": "npm run build -w apps/neurotech",
    "build:neurotech-applications": "npm run build -w apps/neurotech-applications",
    "build": "npm run build:neurotech && npm run build:neurotech-applications",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "e2e": "npm run test:e2e",
    "e2e:site": "playwright test --config playwright.config.ts",
    "e2e:applications": "playwright test --config playwright.neurotech-applications.config.ts",
    "build:vercel": "node scripts/build-vercel.mjs neurotech"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "8.21.0",
    "astro": {
      "esbuild": "0.28.1"
    },
    "vite": {
      ".": "^7.3.2",
      "esbuild": "0.28.1"
    }
  },
  "dependencies": {
    "convex": "^1.37.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.60.0",
    "convex-test": "^0.0.54",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
